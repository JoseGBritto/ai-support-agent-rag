# Business shown in answers and in the widget
BUSINESS_NAME=Andes Coffee Co.

# Any OpenAI-compatible chat API: OpenAI, OpenRouter, Groq, Gemini (OpenAI endpoint), Ollama...
# Leave LLM_API_KEY empty to run in free "demo mode" (extractive answers, no AI costs).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Where human-handoff alerts are POSTed (Slack incoming webhook, n8n, Make, Discord...)
HANDOFF_WEBHOOK_URL=

# Protects /api/admin/* endpoints
ADMIN_TOKEN=change-me

# Comma-separated sites allowed to embed the widget (* = any)
ALLOWED_ORIGINS=*

KNOWLEDGE_DIR=knowledge_base
DATA_DIR=data
